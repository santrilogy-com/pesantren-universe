[Unit]
Description=Pesantren Universe API (verifikasi ID, poin, ranking)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/pesantren-verse-server
EnvironmentFile=/home/ubuntu/pesantren-verse-server/.env
ExecStart=/usr/bin/python3 /home/ubuntu/pesantren-verse-server/server.py
Restart=always
RestartSec=3
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
